# Derived artifacts. Everything here is rebuilt by `python3 build.py --ingest`.
# The figures and the dashboard are the exception: they are the deliverable, the
# README embeds one of them, and a reader should not have to run the pipeline to
# see the result.
data/warehouse.db
data/warehouse.db-wal
data/warehouse.db-shm
data/raw/*.csv
!data/raw/bars_snapshot.csv.gz
__pycache__/
*.pyc
.Rhistory
.DS_Store

# The journal workbook holds real personal trade history. The generator
# (python/make_workbook.py) is versioned instead, so anyone can recreate the
# empty workbook without inheriting someone else's trades.
data/journal.xlsx

# Personal trading configuration and history. The example file is versioned
# instead, so the repo shows the shape without publishing anyone's numbers.
journal/risk-profile.json
journal/trades.jsonl
journal/memos/*.md
journal/logs/*.md

# The forward ledger is the evidence, not scratch output. It is versioned so
# the record can be audited by anyone who clones this.
!data/forward_ledger.jsonl

# The strategy registry is the trial count every correction depends on.
!data/strategy_registry.jsonl

# Signal zoo results are findings, not scratch output.
!reports/signal_zoo.csv

!reports/cross_sectional.csv

data/xs_panel.parquet
# 919MB rebuild of the cross-sectional panel on the full 1,500-name universe.
# Regenerate with: python3 python/breadth.py --rebuild
data/breadth_panel.parquet
# USAspending pull and its entity-resolved join. Regenerate with:
#   python3 python/ingest_contracts.py && python3 python/contract_entities.py
data/contracts.parquet
data/contracts_mapped.parquet
!reports/neutral_book.csv

!reports/earnings_book.csv
!reports/combined_book.csv

!reports/multi_source.csv
!reports/earnings_v2.csv
!reports/regime_test.csv

!reports/cap_spectrum.csv
data/spreads.parquet

!reports/portfolio.csv
!reports/breadth.csv
!reports/resid_r2.csv
!reports/breadth_adj.csv
!reports/contract_car.csv
!reports/contract_car_placebo.csv
!reports/contract_monthly.csv

# Run logs and R binary artifacts. Regenerated by build.py; they are console
# output, not results. The CSVs under reports/ are the findings and stay.
reports/*.log
reports/*.rds

data/sp500_snapshot.json
data/crypto/

# Per-coin resume cache for the funding pull; hl_funding_pit.parquet is the result.
crypto/data/hl_funding_cache/
